# Copy to .env.local. Keep real credentials out of Git and client-side code.
NEXTAUTH_URL=http://127.0.0.1:3005
# Generate a random secret, at least 32 characters (see docs/GOOGLE_AUTH.md).
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email for 6-digit OTP verification & password reset (server-only).
# Configure either BREVO_API_KEY (recommended: works with verified Gmail) or RESEND_API_KEY.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=HyperMockup

# SePay Payment Gateway & Direct VietQR (server-only; never use NEXT_PUBLIC_* for these).
# Start with Test mode. Production uses the same names with SEPAY_ENV=production.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Set this in SePay: Cổng thanh toán → Cấu hình → IPN.
SEPAY_IPN_SECRET=
# Direct VietQR Bank Webhook settings.
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_OWNER=
SEPAY_WEBHOOK_API_KEY=
# Public HTTPS origin used for payment callbacks and embedded checkouts.
SEPAY_PUBLIC_URL=https://hypermockup.com

# Polar.sh Merchant of Record (international USD payments, server-only).
POLAR_ENV=production
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
