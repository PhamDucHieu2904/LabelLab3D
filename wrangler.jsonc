{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "labellab3d-production",
      "database_id": "dc0975db-13d2-425f-a7c2-b182798e03d2",
      "migrations_dir": "db/migrations"
    }
  ],
  // Optional Cloudflare R2 bucket for 3D Share Link label/thumbnail assets
  // (10 GB free storage, $0 egress). Until enabled, assets safely fall back to D1.
  // Run `wrangler r2 bucket create hypermockup-shares` and uncomment below:
  // "r2_buckets": [
  //   {
  //     "binding": "SHARE_BUCKET",
  //     "bucket_name": "hypermockup-shares"
  //   }
  // ],
  "routes": [
    {
      "pattern": "hypermockup.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
