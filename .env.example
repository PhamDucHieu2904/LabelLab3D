# Copy to .env.local. Keep real credentials out of Git and client-side code.
NEXTAUTH_URL=http://127.0.0.1:3005
# Generate a random secret, at least 32 characters (see docs/GOOGLE_AUTH.md).
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SePay Payment Gateway (server-only; never use NEXT_PUBLIC_* for these).
# Start with Test mode. Production uses the same names with SEPAY_ENV=production.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Set this in SePay: Cổng thanh toán → Cấu hình → IPN.
SEPAY_IPN_SECRET=
# Public HTTPS origin used for SePay callbacks (use a deployed URL or tunnel in local dev).
SEPAY_PUBLIC_URL=
